# Copy this file to .env in the repository root, then enter your API keys.
# .env is ignored by Git. Restart Arena / the calibration workshop after edits.
# Match these names to each saved provider's API key environment variable.
# Uncomment only the providers you use. Do not commit or share the real .env.

# ARENA_OPENAI_KEY=your_openai_key
# ARENA_ANTHROPIC_KEY=your_anthropic_key
# ARENA_GEMINI_KEY=your_gemini_key
# ARENA_GROQ_KEY=your_groq_key
