// Aggressive weapon baseline. Supports any roster and equipped player weapons.
var enemy = getNearestEnemy()
if (enemy >= 0 && isAlive(enemy)) {
    moveToward(enemy)
    for (var weapon in getWeapons()) {
        if (!isAlive(enemy)) break
        if (getTP() < getWeaponCost(weapon) || !canUseWeapon(weapon, enemy)) continue
        setWeapon(weapon)
        while (isAlive(enemy) && getTP() >= getWeaponCost() && canUseWeapon(enemy)) {
            if (useWeapon(enemy) != USE_SUCCESS) break
        }
    }
}
