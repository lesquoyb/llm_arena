// Weaker weapon baseline: at most one shot, using an eligible equipped weapon.
var enemy = getNearestEnemy()
if (enemy >= 0 && isAlive(enemy)) {
    moveToward(enemy)
    for (var weapon in getWeapons()) {
        if (getTP() < getWeaponCost(weapon) || !canUseWeapon(weapon, enemy)) continue
        setWeapon(weapon)
        if (useWeapon(enemy) == USE_SUCCESS) break
    }
}
