// Feature demonstration, not an optimized strategy. LeekScript 4.
// Use examples/showcase/tournament.json for the required equipment and stats.
function cast(chip, target) {
    if (!inArray(getChips(), chip) || !isAlive(target)) return -1
    if (getTP() < getChipCost(chip) || getCooldown(chip) > 0) return -1
    if (!canUseChip(chip, target)) return -1
    var result = useChip(chip, target)
    if (result == USE_SUCCESS) debug("chip " + chip + " -> entity " + target)
    return result
}

function healAnAlly() {
    for (var ally in getAllies()) {
        if (isAlive(ally) && getLife(ally) < getTotalLife(ally)) {
            if (cast(CHIP_BANDAGE, ally) == USE_SUCCESS) return;
        }
    }
}

// The callback runs on the summon's turns, with its own AP, MP and chips.
function bulbTurn() {
    debug("bulb turn: entity " + getEntity() + ", owner " + getSummoner())
    var enemy = getNearestEnemy()
    if (enemy >= 0 && isAlive(enemy)) moveToward(enemy, 1)
    healAnAlly()
    if (enemy >= 0 && isAlive(enemy)) cast(CHIP_PEBBLE, enemy)
}

function summonScout() {
    if (getTurn() != 1 || getTP() < getChipCost(CHIP_PUNY_BULB)) return;
    if (getCooldown(CHIP_PUNY_BULB) > 0) return;
    var x = getCellX(getCell())
    var y = getCellY(getCell())
    var cells = [getCellFromXY(x + 1, y), getCellFromXY(x - 1, y),
                 getCellFromXY(x, y + 1), getCellFromXY(x, y - 1)]
    for (var cell in cells) {
        if (cell != null && isEmptyCell(cell) && canUseChipOnCell(CHIP_PUNY_BULB, cell)) {
            var result = summon(CHIP_PUNY_BULB, cell, bulbTurn, "Scout bulb")
            debug("summon result: " + result)
            if (result == USE_SUCCESS) return;
        }
    }
}

summonScout()
healAnAlly()
cast(CHIP_HELMET, getEntity())
cast(CHIP_PROTEIN, getEntity())
var enemy = getNearestEnemy()
if (enemy >= 0 && isAlive(enemy)) {
    moveToward(enemy, 1)
    cast(CHIP_SHOCK, enemy)
    var weapons = getWeapons()
    if (count(weapons) > 0) {
        // Alternate pistol and machine gun to exercise weapon changes.
        setWeapon(weapons[(getTurn() - 1) % count(weapons)])
        while (getWeaponCost() > 0 && getTP() >= getWeaponCost() && isAlive(enemy)) {
            if (useWeapon(enemy) != USE_SUCCESS) break
        }
    }
}
